# Copy to `.env` and fill in: `cp .env.example .env`. forge loads `.env` from the
# repository root automatically. `.env` is gitignored; never commit it.
#
# docs/deploy-runbook.md §2 describes every variable and its bounds.

# RPC for the fork suites under test/fork/ (skipped when unset).
RH_TESTNET_RPC=

# --- script/Deploy.s.sol -----------------------------------------------------
USDG_ADDRESS=
# Unused by the contracts since D-18 (the Permit2 door was removed); recorded only.
PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
# D-17: two different cold keys, neither the deploying key.
OWNER_ADDRESS=
ADMIN_ADDRESS=
TREASURY_ADDRESS=
REDEEMER_ADDRESS=
UNBONDING_PERIOD_SECONDS=
MINIMUM_STAKE=
PENALTY_AMOUNT=
VERIFIER_DAILY_CAP=
TAKE_RATE_BPS=
SLASH_AGENT_BPS=
SLASH_PLATFORM_BPS=
SLASH_CAP_BPS=

# --- script/VerifyDeployment.s.sol -------------------------------------------
PROXY_CONFIG=
PROXY_STAKE=
PROXY_ESCROW=

# --- script/UpgradeOwnerSplit.s.sol / script/UpgradeByOwner.s.sol --------------
EXPECTED_CHAIN_ID=
SAMPLE_BUYER=
SAMPLE_PROVIDER=
# optional (an empty value would fail to parse, so leave these commented until used):
# DEPLOYER_ADDRESS=
# NEW_OWNER=
